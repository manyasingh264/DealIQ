# ==============================================================================
# DealIQ - Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL: Never push API keys or secrets!)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
backend/.env
ms1-core-api/.env
frontend/.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# ------------------------------------------------------------------------------
# Node.js & Frontend Build Outputs
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
.vite/
**/.vite/

# Node logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
venv/
.venv/
env/
ENV/
**/venv/
**/.venv/
**/env/

# Python cache & compiled bytecode
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Type Checking
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ------------------------------------------------------------------------------
# Databases & Local Data Stores
# ------------------------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
ms1-core-api/dealiq.db
backend/dealiq.db

# ------------------------------------------------------------------------------
# Operating System & IDE Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Editors & IDEs
.idea/
.vscode/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
